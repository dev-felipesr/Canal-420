  taskId: bilhete_margaret_dia3_opc
  isLinearObjective: 0
  objectiveHudLabel: 
  interactionPrompt: Abrir o bilhete dobrado
  thoughtSubtitle: Tava dobrado debaixo das pastas desde aquela sexta... Nem li o
    que ela pediu.
  suppressedTruthFlash: 
  subtitleDuration: 5.8
  interactSound: 1
  grantsItemId: 
