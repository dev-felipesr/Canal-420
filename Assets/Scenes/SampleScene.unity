  alertReelRight: {fileID: 0}
  hasReadableDocument: 1
  documentStyle: 0
  documentTitle: BILHETE DE MARGARET
  documentBody: "Cian,\n\nDeixei seu prato tampado no forno, \xE9 s\xF3 esquentar.\nEsperei
    at\xE9 onze e meia, mas as meninas j\xE1 estavam caindo de sono.\n\nQuando voc\xEA
    terminar a\xED, fecha a porta devagar pra n\xE3o acordar elas.\nAmanh\xE3 a gente
    conversa direito, sem gritar na frente das meninas.\n\nMargaret"
  disableAfterFirstUse: 0
  repeatThoughtSubtitle: Eu deixei aqui sem abrir.
  isMultiUseConsumable: 0
