  m_Script: {fileID: 11500000, guid: 30900e83f993441a787c259e52e024df, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Canal420.Interaction.InspectableObject
  taskId: arquivo_metalico_opc
  isLinearObjective: 0
  objectiveHudLabel: 
  interactionPrompt: Ler o recorte de jornal guardado
  thoughtSubtitle: "Conduzido sob cust\xF3dia... A parte de baixo t\xE1 rasgada.
    Eu fui solto? T\xF4 numa cl\xEDnica? Ou nunca sa\xED dessa sala naquela noite?"
  suppressedTruthFlash: 
  subtitleDuration: 5.8
  interactSound: 1
  grantsItemId: 
  visualToHideOnPickup: {fileID: 0}
  requiredItemId: 
  lockedInteractionPrompt: 
  missingRequirementSubtitle: 
  missingRequirementSound: 10
  visualToRevealWhenUnlocked: {fileID: 0}
  emitAlertBeep: 0
  alertBeepInterval: 2.65
  alertLedRenderer: {fileID: 0}
  alertReelLeft: {fileID: 0}
  alertReelRight: {fileID: 0}
  hasReadableDocument: 1
  documentStyle: 3
  documentTitle: JORNAL DA BAIXADA - Domingo, 11 de setembro de 1994
  documentBody: "M\xC3E E DUAS FILHAS S\xC3O ENCONTRADAS MORTAS NA RUA DAS AC\xC1CIAS\n\nA
    Pol\xEDcia Civil investiga a morte de M. N., de 32 anos, e de suas\nduas filhas,
    de 6 e 8 anos, encontradas ontem \xE0 noite (10) dentro de\num sobrado no fim
    da Rua das Ac\xE1cias.\n\nSegundo o boletim de ocorr\xEAncia, vizinhos ouviram
    gritos por volta das\n22h30 e chamaram a PM. Ao arrombarem o quarto dos fundos,
    trancado pelo\nlado de fora, os policiais j\xE1 encontraram as tr\xEAs sem vida.\n\nO
    marido, contador de 34 anos, permanecia em sil\xEAncio na sala quando a\nviatura
    chegou. O IML recolheu os corpos na madrugada e o suspeito foi\nencaminhado sob
    cust\xF3dia para avalia\xE7\xE3o...\n\n[A borda inferior do recorte est\xE1 rasgada
    e borrada de umidade.]"
  disableAfterFirstUse: 0
  repeatThoughtSubtitle: "O peda\xE7o onde dizia o que aconteceu comigo foi arrancado."
  isMultiUseConsumable: 0
  consumableStepVisuals: []
  consumableUseSubtitles: []
  consumableCooldownSubtitle: 
  linkedFaucet: {fileID: 0}
