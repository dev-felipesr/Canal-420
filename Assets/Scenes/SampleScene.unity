  interactionPrompt: Ler o recorte de jornal guardado
  thoughtSubtitle: O final foi arrancado.
  suppressedTruthFlash: 
  subtitleDuration: 5.8
  interactSound: 1
  grantsItemId: 
  visualToHideOnPickup: {fileID: 0}
