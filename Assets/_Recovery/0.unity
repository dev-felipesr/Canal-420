  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Canal420.Interaction.InspectableObject
  taskId: gaveta_afastamento_opc
  isLinearObjective: 0
  objectiveHudLabel: 
  interactionPrompt: "Ler o formul\xE1rio na gaveta"
  thoughtSubtitle: "Preenchi em agosto e tranquei aqui. Pedir licen\xE7a l\xE1 dentro
    \xE9 pedir pra ser demitido."
  subtitleDuration: 5.8
  interactSound: 1
  grantsItemId: 
  visualToHideOnPickup: {fileID: 0}
  requiredItemId: 
  lockedInteractionPrompt: 
  missingRequirementSubtitle: 
  missingRequirementSound: 10
  visualToRevealWhenUnlocked: {fileID: 0}
  emitAlertBeep: 0
  alertBeepInterval: 2.65
  alertLedRenderer: {fileID: 0}
  hasReadableDocument: 1
  documentStyle: 1
  documentTitle: "REQUERIMENTO DE LICEN\xC7A M\xC9DICA \u2014 RH (RASCUNHO)"
  documentBody: "FUNCION\xC1RIO: Cian Nabs  |  SETOR: Contabilidade e Auditoria\nDATA
    DO PREENCHIMENTO: 14/08/1995\n\nQUADRO RELATADO PELO SERVIDOR:\nIns\xF4nia severa
    h\xE1 mais de quatro meses, dores tensionais di\xE1rias,\napag\xF5es de mem\xF3ria
    recente durante a confer\xEAncia de planilhas e tremor nas m\xE3os.\n\nASSINATURA
    DO SOLICITANTE: ___________________________\nPROTOCOLO DA CHEFIA: [EM BRANCO
    \u2014 N\xC3O ENTREGUE]"
  disableAfterFirstUse: 0
  repeatThoughtSubtitle: "Nunca entreguei. Quem reclama l\xE1 dentro roda."
  onFirstInteract:
    m_PersistentCalls:
      m_Calls: []
  onAnyInteract:
    m_PersistentCalls:
      m_Calls: []
