  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Canal420.Interaction.InspectableObject
  taskId: olhar_papeis
  isLinearObjective: 1
  objectiveHudLabel: "Revisar as pastas na mesa do escrit\xF3rio"
  interactionPrompt: Revisar as pastas da mesa
  thoughtSubtitle: "Doze horas por dia numa sala fechada e ele fala em queda de rendimento.
    Os n\xFAmeros j\xE1 est\xE3o embaralhando na vista."
  subtitleDuration: 5.8
  interactSound: 1
  grantsItemId: 
  visualToHideOnPickup: {fileID: 0}
  requiredItemId: 
  lockedInteractionPrompt: 
  missingRequirementSubtitle: 
  missingRequirementSound: 10
  visualToRevealWhenUnlocked: {fileID: 0}
  emitAlertBeep: 0
  alertBeepInterval: 2.65
  alertLedRenderer: {fileID: 0}
  hasReadableDocument: 1
  documentStyle: 1
  documentTitle: "MEMORANDO INTERNO \u2014 AUDITORIA CONT\xC1BIL (27/10/1995)"
  documentBody: "PARA: Cian Nabs (Analista Cont\xE1bil Pleno)\nDE: Ger\xEAncia Operacional
    \u2014 Tavares\n\nConstatamos diverg\xEAncias nas folhas 14, 19 e 22 do balancete
    de outubro,\nal\xE9m de atrasos recorrentes nas entregas da \xFAltima quinzena.\n\nExigimos
    a confer\xEAncia integral dos tr\xEAs lotes at\xE9 segunda-feira (30/10),\n\xE0s
    08h00. Quedas injustificadas de rendimento ser\xE3o reportadas \xE0 diretoria."
  disableAfterFirstUse: 0
  repeatThoughtSubtitle: "As linhas est\xE3o borrando. Hoje n\xE3o sai mais nada
    daqui."
  onFirstInteract:
    m_PersistentCalls:
      m_Calls: []
  onAnyInteract:
    m_PersistentCalls:
      m_Calls: []
