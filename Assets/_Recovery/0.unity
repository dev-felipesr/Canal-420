  hasReadableDocument: 1
  documentStyle: 0
  documentTitle: BILHETE DOBRADO
  documentBody: "Cian,\n\nDeixei o seu prato no forno. Voc\xEA disse que chegava
    cedo, mas j\xE1 passa das\nonze e as meninas dormiram perguntando pelo pai.\n\nN\xE3o
    precisa responder agora. S\xF3 n\xE3o volte de cabe\xE7a quente como ontem.\n\n                                                       
    \u2014 M."
  disableAfterFirstUse: 0
  repeatThoughtSubtitle: "A comida esfriou no forno. Eu n\xE3o voltei a tempo."
  onFirstInteract:
    m_PersistentCalls:
      m_Calls: []
  onAnyInteract:
    m_PersistentCalls:
      m_Calls: []
