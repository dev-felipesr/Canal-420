  taskId: arquivo_metalico_opc
  isLinearObjective: 0
  objectiveHudLabel: 
  interactionPrompt: Ler o recorte de jornal guardado
  thoughtSubtitle: Recortei no domingo e tranquei aqui. Achava que esconder o jornal
    apagava o que aconteceu.
  subtitleDuration: 5.8
  interactSound: 1
  grantsItemId: 
  visualToHideOnPickup: {fileID: 0}
  requiredItemId: 
  lockedInteractionPrompt: 
  missingRequirementSubtitle: 
  missingRequirementSound: 10
  visualToRevealWhenUnlocked: {fileID: 0}
  emitAlertBeep: 0
  alertBeepInterval: 2.65
  alertLedRenderer: {fileID: 0}
  hasReadableDocument: 1
  documentStyle: 3
  documentTitle: "JORNAL DA BAIXADA \u2014 Domingo, 11 de setembro de 1994"
  documentBody: "OCORR\xCANCIA NA RUA DAS AC\xC1CIAS\n\nVizinhos acionaram a Pol\xEDcia
    Civil na noite de ontem, s\xE1bado (10),\ndepois de ouvirem gritos e um estrondo
    vindos de um sobrado no fim da rua.\n\nOs agentes encontraram a porta dos fundos
    aberta e a casa \xE0s escuras.\nO morador, contador de 34 anos, n\xE3o quis falar
    com a imprensa. A per\xEDcia\nainda n\xE3o informou as causas.\n\nA mulher e
    as duas filhas do casal, de seis e oito anos, foram retiradas\ndo local. O estado
    das tr\xEAs n\xE3o foi divulgado."
  disableAfterFirstUse: 0
  repeatThoughtSubtitle: "N\xE3o preciso ler de novo. Sei de cor o que est\xE1 escrito."
  onFirstInteract:
    m_PersistentCalls:
      m_Calls: []
  onAnyInteract:
    m_PersistentCalls:
      m_Calls: []
