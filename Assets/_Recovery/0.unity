  taskId: frascos_calmantes_dia2
  isLinearObjective: 1
  objectiveHudLabel: Examinar os frascos sobre a mesa de centro
  interactionPrompt: Examinar os frascos sobre a mesa
  thoughtSubtitle: Virei os comprimidos no escuro, olhando pra TV. Nem contei. O
    corpo todo pesa.
  subtitleDuration: 5.8
  interactSound: 3
  grantsItemId: 
  visualToHideOnPickup: {fileID: 0}
