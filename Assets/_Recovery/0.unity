  interactionPrompt: Ler o bilhete dobrado na escrivaninha
  thoughtSubtitle: Estava dobrado no meio das pastas do Tavares. Eu nem abri naquela
    noite.
  subtitleDuration: 5.8
  interactSound: 1
  grantsItemId: 
